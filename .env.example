# Database
# Local Docker Compose:
# DATABASE_URL="mysql://reviewtap_user:reviewtap_pass@db:3306/reviewtap"
# Firebase / Cloud SQL production:
# DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/reviewtap"
DATABASE_URL="mysql://reviewtap_user:reviewtap_pass@db:3306/reviewtap"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Firebase deployment values
# Set these to your production domain after deploy.
# NEXTAUTH_URL="https://your-project.web.app"
# NEXT_PUBLIC_ROOT_DOMAIN="your-domain.com"
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# OpenAI
OPENAI_API_KEY="sk-your-openai-key"

# Email (SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@reviewtap.in"
SMTP_PASS="your-smtp-password"
SMTP_FROM="ReviewTap <noreply@reviewtap.in>"

# Domain
NEXT_PUBLIC_ROOT_DOMAIN="reviewtap.in"
NEXT_PUBLIC_APP_URL="https://reviewtap.in"

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
